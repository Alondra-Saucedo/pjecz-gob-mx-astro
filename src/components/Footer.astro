---
/**
 * Footer institucional — logo, columnas de enlaces y línea legal.
 */
const FOOTER_COLS = [
  {
    title: 'Institución',
    items: [
      { label: '¿Quiénes somos?', href: '/conocenos/quienes-somos/' },
      { label: 'Estructura', href: '/conocenos/estructura/' },
      { label: 'Observatorio Judicial', href: '/conocenos/observatorio-judicial/' },
      { label: 'Transparencia', href: '/transparencia/' },
      { label: 'Transparencia Proactiva', href: '/transparencia-proactiva/' }
    ]
  },
  {
    title: 'Servicios y trámites',
    items: [
      { label: 'Poder en Línea', href: 'https://poderenlinea.gob.mx/auth/login' },
      { label: 'Citas', href: 'https://citas.saji.gob.mx' },
      { label: 'Listas de Acuerdo', href: '/consultas/listas-de-acuerdo/' },
      { label: 'Trámites y servicios', href: '/tramites-y-servicios/' },
      { label: 'Edictos en Línea', href: '/consultas/edictos/' }
    ]
  },
  {
    title: 'Publicaciones',
    items: [
      { label: 'Boletines Judiciales', href: '/boletines-judiciales/' },
      { label: 'Acuerdos del Pleno', href: '/acuerdos-del-pleno/' },
      { label: 'Acuerdos del Consejo', href: '/acuerdos-del-consejo/' },
      { label: 'Tesis y Jurisprudencias', href: '/consultas/tesis-jurisprudencias/' },
      { label: 'Versión Pública de Sentencias', href: '/consultas/sentencias/' }
    ]
  },
  {
    title: 'Sala de Prensa',
    items: [
      { label: 'Comunicados', href: '/comunicados/' },
      { label: 'Noticias', href: '/noticias/' },
      { label: 'Calendario de Labores', href: '/calendario-de-labores/' }
    ]
  }
];
---
<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/assets/logo-vertical-white.png" alt="Poder Judicial del Estado de Coahuila de Zaragoza" />
        <p>Palacio de Justicia, Saltillo, Coahuila de Zaragoza. México.</p>
      </div>
      {FOOTER_COLS.map((col) => (
        <div class="footer-col">
          <div class="footer-col__title">{col.title}</div>
          <ul>
            {col.items.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-legal">
      <span>© 2026 PODER JUDICIAL DEL ESTADO DE COAHUILA DE ZARAGOZA</span>
      <span>TODOS LOS DERECHOS RESERVADOS · AVISO DE PRIVACIDAD · ACCESIBILIDAD</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--pj-black-100);
    color: var(--pj-black-25);
    margin-top: var(--space-9);
    padding: var(--space-8) 0 var(--space-6);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: var(--space-7);
  }
  .footer-brand img { height: 140px; width: auto; }
  .footer-brand p {
    font: 400 var(--fs-13)/1.55 var(--font-sans);
    color: var(--pj-black-50);
    margin-top: var(--space-4);
    max-width: 280px;
  }
  .footer-col__title {
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--pj-white);
    margin-bottom: var(--space-5);
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .footer-col a {
    font: 400 var(--fs-13) var(--font-sans);
    color: var(--pj-black-25);
  }
  .footer-col a:hover { color: var(--pj-white); }

  .footer-legal {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255,255,255,.12);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    font: 400 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wide);
    color: var(--pj-black-50);
  }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>