---
/**
 * ServicesStrip — accesos a servicios al ciudadano en rejilla de 4.
 */
import Overline from './Overline.astro';

interface Service {
  title: string;
  desc: string;
  href: string;
}

const SERVICES: Service[] = [
  { title: 'Poder en Línea', desc: 'Expediente Virtual, Buzón Electrónico, Sistema de Citas y Boletas Electrónicas de Gestión Actuarial se integran con "Poder en Linea v2.0", una plataforma unificada para facilitar todos sus procesos a distancia.', href: 'https://poderenlinea.gob.mx/auth/login' },
  { title: 'Sistema de Citas',    desc: 'En esta sección puedes agendar tu visita a nuestros órganos jurisdiccionales.', href: 'https://citas.saji.gob.mx' },
  { title: 'Listas de Acuerdos',       desc: 'Este apartado muestra el listado en donde se incluyen autos, acuerdos, sentencias, exhortos y audiencias.', href: '/consultas/listas-de-acuerdos/' },
  { title: 'Transparencia',           desc: 'Información pública, informes y normativa.', href: 'https://storage.googleapis.com/pjecz-gob-mx/Derechos%20Humanos%20e%20Igualdad%20de%20G%C3%A9nero/Documentos%20de%20Inter%C3%A9s/Protocolos%20de%20Actuaci%C3%B3n/Protocolo%20de%20AGAJP%20Discapacidad.pdf' },
];
---
<section class="services">
  <div class="container-wide">
    <Overline>Accesos Directos</Overline>
    <div class="services__grid">
      {SERVICES.map((s) => (
        <a class="service" href={s.href}>
          <img class="service__star" src="/assets/star.png" alt="" aria-hidden="true" />
          <div class="service__title">{s.title}</div>
          <div class="service__desc">{s.desc}</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg-muted);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border-faint);
    border-bottom: 1px solid var(--border-faint);
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    margin-top: var(--space-5);
    border: 1px solid var(--border);
  }
  .service {
    background: var(--bg-muted);
    padding: var(--space-6) 28px;
    transition: background .2s ease;
  }
  .service:hover { background: var(--bg); }
  .service__star { height: 20px; margin-bottom: 18px; opacity: .85; }
  .service__title { font: 400 var(--fs-24)/1.2 var(--font-display); color: var(--fg); margin-bottom: var(--space-2); }
  .service__desc { font: 400 var(--fs-13)/1.55 var(--font-sans); color: var(--fg-muted); }

  @media (max-width: 860px) { .services__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .services__grid { grid-template-columns: 1fr; } }
</style>